{
  "name": "gripfetch-apt",
  "version": "0.1.0",
  "description": "gripsack sugar: fetch Debian packages through the gripfetch-apt plugin (wraps the host's apt)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gripsack-dev/gripfetch-apt.git"
  },
  "keywords": [
    "gripsack",
    "gripfetch",
    "apt",
    "debian"
  ],
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/index.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
